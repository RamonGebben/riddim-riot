{
  "name": "dubstep-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:e2e": "playwright test",
    "test:storybook": "vitest --project=storybook --run",
    "prepare": "husky"
  },
  "dependencies": {
    "@pindakaasman/design-system": "^4.0.0",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@pindakaasman/eslint-config": "^0.4.0",
    "@pindakaasman/prettier-config": "^0.1.2",
    "@pindakaasman/tsconfig": "^0.2.2",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "prettier": "@pindakaasman/prettier-config"
}
