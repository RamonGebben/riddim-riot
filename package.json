{
  "name": "riddim-riot",
  "private": true,
  "version": "0.0.0",
  "description": "A twin-stick rhythm shooter in the browser where every gun is a bass synth.",
  "license": "MIT",
  "author": "Ramon Gebben",
  "homepage": "https://riddimriot.com",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:e2e": "playwright test",
    "test:storybook": "vitest --project=storybook --run",
    "prepare": "husky",
    "db:migrate": "dotenv -e .env.local -- node scripts/migrate.ts",
    "test:db": "dotenv -e .env.local -- vitest run --project=db"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@pindakaasman/design-system": "^4.0.0",
    "@tanstack/react-query": "^5.108.0",
    "@trpc/client": "^11.29.5",
    "@trpc/server": "^11.29.5",
    "@trpc/tanstack-react-query": "^11.29.5",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "obscenity": "^0.4.6",
    "pixi.js": "^8.23.0",
    "ramda": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "tone": "^15.1.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@pindakaasman/eslint-config": "^0.4.0",
    "@pindakaasman/prettier-config": "^0.1.2",
    "@pindakaasman/tsconfig": "^0.2.2",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "prettier": "@pindakaasman/prettier-config"
}
