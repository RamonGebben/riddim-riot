{
  "extends": "@pindakaasman/tsconfig/app.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "e2e", ".storybook", "*.ts", "*.mts"],
  "exclude": ["node_modules", "dist"]
}
